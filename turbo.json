{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    }
  },
  "globalPassThroughEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "SESSION_JWT_SECRET",
    "API_PORT",
    "PAYMENTS_PROVIDER",
    "MOCK_WEBHOOK_SECRET",
    "PAGARME_*",
    "WEB_BASE_URL",
    "PRODUCER_BASE_URL",
    "EMAIL_PROVIDER",
    "WHATSAPP_PROVIDER",
    "PUSH_PROVIDER",
    "EXPO_ACCESS_TOKEN",
    "PLATFORM_*",
    "NEXT_PUBLIC_*"
  ]
}
