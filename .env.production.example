# BoraFest — variáveis de PRODUÇÃO. Lista de referência, SEM valores reais.
# Revisado em 2026-10-12 contra o código (process.env em apps/ e packages/).
#
# ONDE ISTO VAI
# - Produção de verdade = EasyPanel: cada variável vai no "Environment" do
#   serviço Compose, que sobe o docker-compose.yml da raiz. O compose monta
#   DATABASE_URL e REDIS_URL sozinho a partir de POSTGRES_PASSWORD e
#   REDIS_PASSWORD. Passo a passo: docs/projeto/DEPLOY.md.
# - Variável só chega ao contêiner se o docker-compose.yml a listar no
#   "environment:" do serviço (api, worker, pg-backup...). Variável nova =
#   Environment do painel + linha no compose + Implantar de novo. Nem toda
#   variável que o código lê é repassada pelo compose hoje: confira o
#   docker-compose.yml antes de contar com uma das comentadas abaixo.
# - Variável definida passa por cima do padrão do código. Deixe COMENTADO o
#   que não for mudar (em 14/08 um piso antigo no ambiente fez a taxa do Pix
#   sair R$ 2,50 em vez de R$ 1,00).
# - NEXT_PUBLIC_* (site, painel, backoffice) NÃO vêm daqui: são embutidas no
#   BUILD, com padrão de produção nos ARG de infra/docker/easypanel/Dockerfile.*.
# - Caminho alternativo (servidor próprio com Caddy, não é a produção):
#   cp .env.production.example .env.production   # e preencha
#   docker compose -f infra/docker/docker-compose.prod.yml --env-file .env.production up -d --build
#
# Legenda: [api] [worker] [ambos] = quem lê. OBRIGATÓRIA = sem ela a API ou o
# worker se recusam a subir com NODE_ENV=production, ou o recurso não funciona.
# Segredo: gere, guarde num gerenciador de senhas e nunca cole em chat,
# commit ou print. Chave que passou por chat deve ser trocada.

# --- banco e Redis ---
# OBRIGATÓRIA [postgres, pg-backup, api, worker] — openssl rand -hex 24
POSTGRES_PASSWORD=
# OBRIGATÓRIA [redis, api, worker] — openssl rand -hex 24
REDIS_PASSWORD=

# --- segredos do sistema ---
# OBRIGATÓRIA [api] assina as sessões — openssl rand -hex 32
# Trocar desloga todo mundo (avise antes).
SESSION_JWT_SECRET=
# OBRIGATÓRIA na prática [api] (2026-10-12) cifra o segredo do app autenticador
# (2FA) dos admins. Sem ela ninguém ativa o 2FA e aprovar saque, marcar
# repasse pago e estornar ficam bloqueados no backoffice.
# openssl rand -base64 32 (mínimo 32 caracteres). Não troque depois de ativar
# o 2FA: os códigos já cadastrados deixam de abrir.
TOTP_ENCRYPTION_KEY=
# [ambos] (2026-10-12) cifra a chave que assina os QR de cada evento.
# openssl rand -base64 32 (32 bytes em base64). A MESMA na API e no worker.
# Guarde fora do servidor: sem ela, um banco restaurado não assina QR.
# Sem ela, a chave fica em texto puro no banco (e no backup) e o boot avisa.
# Depois de definir: apps/api/scripts/cifrar-chaves-qr.ts (DEPLOY.md, §7).
TICKET_KEY_ENCRYPTION_KEY=
# [ambos] protege o /metrics (sem ela a rota responde 404 e o Grafana fica
# sem dados). O Prometheus precisa mandar o mesmo token — openssl rand -hex 32
METRICS_TOKEN=
# [api] e-mails (separados por vírgula) que viram ADMIN do backoffice no boot.
# Não rebaixa ninguém; o login continua pelo código no e-mail.
PLATFORM_ADMIN_EMAILS=

# --- perímetro ---
# OBRIGATÓRIA [api] lista de origens liberadas (o compose já traz este padrão)
CORS_ORIGINS=https://borafest.com.br,https://painel.borafest.com.br,https://admin.borafest.com.br
# [api] nº de proxies na frente da API (Traefik do EasyPanel ou Caddy = 1;
# "true" vale 1). Também aceita o IP/CIDR do proxy. O compose do EasyPanel já
# fixa "true".
TRUST_PROXY=1

# --- endereços públicos (o compose já traz estes padrões) ---
# [ambos] site do comprador: links dos e-mails. Nunca localhost em produção.
WEB_BASE_URL=https://borafest.com.br
# [ambos] painel do produtor: links dos e-mails para a equipe
PRODUCER_BASE_URL=https://painel.borafest.com.br
# [ambos] endereço público da API: links de imagem e do QR
API_PUBLIC_URL=https://api.borafest.com.br
# [worker] opcionais: links do carrinho abandonado (padrão: WEB_BASE_URL) e
# endereço do evento mandado à Meta (padrão: https://borafest.com.br)
# CHECKOUT_BASE_URL=
# CHECKOUT_PUBLIC_URL=
# NEXT_PUBLIC_SITE_URL não vai aqui: é ARG do Dockerfile.checkout (padrão
# https://borafest.com.br). Monta canonical, robots.txt e sitemap.xml.

# --- pagamentos ---
# OBRIGATÓRIA [ambos] provedor padrão e do repasse automático: asaas |
# mercadopago | pagarme. "mock" é recusado em produção.
PAYMENTS_PROVIDER=asaas
# [ambos] provedor por meio de pagamento (vazio = PAYMENTS_PROVIDER).
# Pelo registro de agosto, a produção usa o Pix no mercadopago. Confira em
# backoffice → Configuração.
PAYMENTS_PROVIDER_PIX=
PAYMENTS_PROVIDER_CARD=
# [ambos] reserva automática se o principal cair no pico (vazio = sem reserva)
PAYMENTS_FALLBACK_PIX=
PAYMENTS_FALLBACK_CARD=
# Desde 2026-10-12 a API não sobe se faltar a chave de um provedor usado no
# padrão, no Pix ou no cartão. Reserva sem chave só avisa no log.
# Asaas — webhook: https://api.borafest.com.br/v1/webhooks/payments/asaas
ASAAS_API_KEY=
# token que você define ao cadastrar o webhook no painel do Asaas
ASAAS_WEBHOOK_TOKEN=
# ASAAS_API_URL=https://api-sandbox.asaas.com/v3   (só para sandbox)
# Mercado Pago — webhook: https://api.borafest.com.br/v1/webhooks/payments/mercadopago
MERCADOPAGO_ACCESS_TOKEN=
# assinatura secreta do webhook, no painel do Mercado Pago
MERCADOPAGO_WEBHOOK_SECRET=
# Pagar.me — plano B, sem uso em produção
# PAGARME_SECRET_KEY=
# PAGARME_WEBHOOK_BASIC_USER=
# PAGARME_WEBHOOK_BASIC_PASSWORD=
# [api] menor cobrança online, em centavos (padrão 500 = R$ 5,00)
# PAYMENT_MIN_CHARGE_CENTS=500
# [api] validade do Pix do sinal VIP, em segundos (padrão 1800, mínimo 60)
# VIP_PIX_EXPIRES_SECONDS=1800

# --- taxa da plataforma (padrões do código; Casa com taxa própria usa a dela) ---
# Só defina para MUDAR o padrão. Hoje o compose repassa estas só para a API
# (o sinal VIP, calculado no worker, usa o padrão do código).
# PLATFORM_PIX_FEE_BPS=500
# PLATFORM_PIX_FEE_FLOOR_CENTS=100
# PLATFORM_CARD_FEE_BPS=500
# PLATFORM_CARD_FEE_FLOOR_CENTS=150

# --- saldo e repasses ---
# [worker] Pix de saída automático. false = o backoffice paga à mão. Só o
# Asaas transfere, e pelo PAYMENTS_PROVIDER.
AUTO_TRANSFER_ENABLED=false
# [worker] intervalo da varredura de repasses, em ms (padrão 300000 = 5 min)
# AUTO_PAYOUTS_SWEEP_MS=300000
# [ambos] saque mínimo, em centavos (padrão 5000 = R$ 50,00)
# AUTO_PAYOUT_MIN_CENTS=5000
# [ambos] taxa de antecipação ao mês, em centésimos de % (padrão 125 = 1,25%)
# ANTICIPATION_FEE_BPS_MONTHLY=125
# [api] quanto do saldo retido a antecipação libera (padrão 8000 = 80%)
# ANTICIPATION_MAX_BPS=8000
# [ambos] dias úteis depois do fim do evento para o saldo liberar (padrão 2).
# Hoje o compose não repassa esta: vale o padrão.
# RELEASE_BUSINESS_DAYS_AFTER_EVENT=2

# --- e-mail, WhatsApp e push ---
# OBRIGATÓRIA [ambos] "devlog" é recusado em produção (grava código de login no log)
EMAIL_PROVIDER=resend
# OBRIGATÓRIA [ambos] chave de envio do Resend
RESEND_API_KEY=
# OBRIGATÓRIA [ambos] remetente num domínio "Verified" no Resend
EMAIL_FROM="BoraFest <ingressos@borafest.com.br>"
# [api] (2026-10-12) "Signing secret" do webhook do Resend (entregue,
# devolvido, spam). URL: https://api.borafest.com.br/v1/webhooks/resend
# Sem ele o sistema não sabe se o e-mail chegou.
RESEND_WEBHOOK_SECRET=
# [ambos] off | meta. "devlog" é recusado em produção. Desligado por decisão.
WHATSAPP_PROVIDER=off
# só com WHATSAPP_PROVIDER=meta
# WHATSAPP_CLOUD_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# [ambos] push dos apps (padrão expo; "devlog" é recusado em produção)
# PUSH_PROVIDER=expo
# EXPO_ACCESS_TOKEN=
# [ambos] Web Push do painel (aviso de venda): npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@borafest.com.br

# --- backup (serviço pg-backup; detalhes em infra/scripts/README.md) ---
# Senha longa só com letras e números. Guarde FORA do servidor: sem ela,
# nenhum backup criptografado abre. Sem ela o backup sai sem criptografia e
# não vai para fora do servidor.
BACKUP_ENCRYPTION_PASSPHRASE=
# cópia para fora do servidor (S3 compatível: Backblaze B2, Cloudflare R2, AWS)
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
# BACKUP_S3_PROVIDER=Other
# BACKUP_S3_PREFIX=borafest
# BACKUP_RETENTION_DAYS=14
# webhook do Slack ou do Discord para avisar quando o backup falha
BACKUP_ALERT_WEBHOOK_URL=

# --- observabilidade (Prometheus + Grafana) ---
GRAFANA_ADMIN_USER=admin
# OBRIGATÓRIA antes de apontar um domínio para o Grafana — openssl rand -hex 16
GRAFANA_ADMIN_PASSWORD=
# ex.: https://metrics.borafest.com.br
GRAFANA_ROOT_URL=
# [ambos] info | debug | warn | error (padrão info)
# LOG_LEVEL=info
# [worker] só para testar a API de Conversões da Meta
# META_CAPI_TEST_CODE=
# META_CAPI_VERSION=v21.0

# --- ajuste fino do worker (padrões do código; o compose não repassa) ---
# 1º lembrete do carrinho abandonado (15 min), resgate depois de expirar
# (1 h), idade máxima para o resgate (6 h), varredura da sala de espera (10 s)
# ABANDONED_CART_AFTER_MS=900000
# ABANDONED_RESCUE_AFTER_MS=3600000
# ABANDONED_RESCUE_MAX_AGE_MS=21600000
# WAITING_ROOM_SWEEP_MS=10000
# endereços alternativos dos provedores (só sandbox ou teste)
# MERCADOPAGO_API_URL=
# PAGARME_API_URL=https://api.pagar.me/core/v5

# --- fixas no docker-compose.yml do EasyPanel (não defina no painel) ---
# NODE_ENV=production, API_PORT=3333, UPLOADS_DIR=/repo/uploads,
# DATABASE_URL e REDIS_URL (montadas a partir das senhas acima).
# O worker expõe /metrics na porta WORKER_METRICS_PORT (padrão 9464, a que o
# Prometheus lê).
# NUNCA em produção: RATE_LIMIT_DISABLED (só vale em dev/test, para o teste de
# carga) e MOCK_WEBHOOK_SECRET (provedor de mentira).

# --- SÓ no caminho alternativo (Caddy, infra/docker/docker-compose.prod.yml) ---
# Domínios com DNS apontando para o servidor
API_DOMAIN=api.borafest.com.br
CHECKOUT_DOMAIN=borafest.com.br
PRODUCER_DOMAIN=painel.borafest.com.br
ADMIN_DOMAIN=admin.borafest.com.br
GRAFANA_DOMAIN=metrics.borafest.com.br
POSTGRES_USER=borafest
POSTGRES_DB=borafest
# host "postgres" = nome do serviço no compose; a senha é a de POSTGRES_PASSWORD
DATABASE_URL=postgresql://borafest:TROQUE-ME@postgres:5432/borafest?schema=public
