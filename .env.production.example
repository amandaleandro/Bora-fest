# Copie para .env.production e preencha ANTES de subir o compose de produção.
# docker compose -f infra/docker/docker-compose.prod.yml --env-file .env.production up -d --build

# --- domínios (DNS apontando para o servidor) ---
API_DOMAIN=api.borafest.com.br
CHECKOUT_DOMAIN=borafest.com.br
PRODUCER_DOMAIN=painel.borafest.com.br
ADMIN_DOMAIN=admin.borafest.com.br
GRAFANA_DOMAIN=metrics.borafest.com.br

# --- observabilidade (Prometheus + Grafana) ---
GRAFANA_ADMIN_USER=admin
# gere com: openssl rand -hex 16
GRAFANA_ADMIN_PASSWORD=TROQUE-ME

# --- banco ---
POSTGRES_USER=borafest
POSTGRES_PASSWORD=TROQUE-ME
POSTGRES_DB=borafest
# host "postgres" = nome do serviço no compose
DATABASE_URL=postgresql://borafest:TROQUE-ME@postgres:5432/borafest?schema=public

# --- segredos ---
# gere com: openssl rand -hex 32
SESSION_JWT_SECRET=

# --- perímetro ---
# allowlist de origens (obrigatório em produção)
CORS_ORIGINS=https://borafest.com.br,https://painel.borafest.com.br,https://admin.borafest.com.br
# só ative com proxy confiável (Caddy) na frente — senão o rate limit é burlável
TRUST_PROXY=true

# --- pagamentos (Asaas primário; Pagar.me plano B) ---
PAYMENTS_PROVIDER=asaas
ASAAS_API_KEY=
# token que você define ao cadastrar o webhook no painel Asaas
ASAAS_WEBHOOK_TOKEN=
# PAGARME_SECRET_KEY=
# PAGARME_WEBHOOK_BASIC_USER=
# PAGARME_WEBHOOK_BASIC_PASSWORD=

# --- mensageria (trocar quando os adapters reais existirem) ---
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="BoraFest <ingressos@borafest.com.br>"
# WHATSAPP_PROVIDER=meta quando as chaves da Meta Cloud API existirem
WHATSAPP_PROVIDER=devlog
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# valor mínimo por cobrança do provedor (Asaas: R$ 5,00)
PAYMENT_MIN_CHARGE_CENTS=500

# --- repasses ---
ANTICIPATION_FEE_BPS_MONTHLY=125
AUTO_PAYOUT_MIN_CENTS=5000
# Pix de saída automático no repasse (false = backoffice paga manualmente)
AUTO_TRANSFER_ENABLED=false
# frequência da varredura de repasses (ms) — 5 min com transferência ligada
AUTO_PAYOUTS_SWEEP_MS=300000

# --- taxa da plataforma (decisão 2026-07-23; overrides por org no backoffice) ---
PLATFORM_PIX_FEE_BPS=499
PLATFORM_PIX_FEE_FLOOR_CENTS=249
PLATFORM_CARD_FEE_BPS=699
