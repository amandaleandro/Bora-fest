DATABASE_URL="postgresql://borafest:borafest@localhost:5443/borafest?schema=public"
REDIS_URL="redis://localhost:6380"
NODE_ENV=development
API_PORT=3333
# só para o teste de carga (COMO-RODAR.md): desliga o limite de requisições.
# Vale só com NODE_ENV=development ou test; em produção é ignorada.
# RATE_LIMIT_DISABLED=1
# porta onde o worker expõe GET /metrics (Prometheus) — a api usa a própria API_PORT
WORKER_METRICS_PORT=9464
# obrigatória também em dev: openssl rand -hex 32
SESSION_JWT_SECRET=
# Chaves novas de 2026-10-12 (lista de produção: .env.production.example).
# 2FA do backoffice: sem ela não dá para ativar o app autenticador nem testar
# as ações de dinheiro do admin. openssl rand -base64 32
TOTP_ENCRYPTION_KEY=
# cifra a chave que assina os QR; vazia = texto puro (o boot avisa). A MESMA
# na API e no worker. openssl rand -base64 32
TICKET_KEY_ENCRYPTION_KEY=
# protege o GET /metrics (vazio = a rota responde 404)
METRICS_TOKEN=
# e-mails (vírgula) que viram ADMIN do backoffice ao rodar o seed
PLATFORM_ADMIN_EMAILS=
# roteamento por método (vazio = tudo em PAYMENTS_PROVIDER). Deixe vazio em
# dev: com o Mercado Pago aqui, os testes criavam cobrança de verdade (12/08).
PAYMENTS_PROVIDER_PIX=
PAYMENTS_PROVIDER_CARD=
# reserva automática se o primário falhar no pico
PAYMENTS_FALLBACK_PIX=
PAYMENTS_FALLBACK_CARD=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
PAYMENTS_PROVIDER=mock
MOCK_WEBHOOK_SECRET=mock-webhook-secret-dev

# Asaas (PAYMENTS_PROVIDER=asaas em produção: cartão e repasse automático;
# o Pix de produção vai pelo Mercado Pago — docs/projeto/FLUXO-FINANCEIRO.md)
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# ASAAS_API_URL=https://api-sandbox.asaas.com/v3 (sandbox; produção é o default)

# Pagar.me (plano B, sem uso em produção — PAYMENTS_PROVIDER=pagarme)
PAGARME_SECRET_KEY=
PAGARME_WEBHOOK_SECRET=
PAGARME_WEBHOOK_BASIC_USER=
PAGARME_WEBHOOK_BASIC_PASSWORD=
# PAGARME_API_URL=https://api.pagar.me/core/v5
# Chave PÚBLICA (pk_) — vai no app mobile (EXPO_PUBLIC_PAGARME_PUBLIC_KEY),
# nunca no backend. Sem ela, o app de comprador tokeniza cartão em modo mock.

# Repasses (decisão 2026-07-28)
# antecipação p/ modo INSTANTÂNEO: 1,25% a.m. pró-rata (padrão de mercado)
ANTICIPATION_FEE_BPS_MONTHLY=125
# valor mínimo p/ o repasse automático criar um payout (R$ 50,00)
AUTO_PAYOUT_MIN_CENTS=5000
# Pix de saída automático no repasse (false = backoffice paga manualmente)
AUTO_TRANSFER_ENABLED=false
# frequência da varredura de repasses (ms) — 5 min com transferência ligada
AUTO_PAYOUTS_SWEEP_MS=300000

# valor mínimo por cobrança do provedor (Asaas: R$ 5,00)
PAYMENT_MIN_CHARGE_CENTS=500

# Notificações (Fase 5)
WEB_BASE_URL=http://localhost:3000
# o site em si (canonical, sitemap, robots) lê NEXT_PUBLIC_SITE_URL no BUILD do
# apps/checkout (Dockerfile.checkout); sem ela: produção = https://borafest.com.br,
# dev = http://localhost:3000 (2026-10-12)
PRODUCER_BASE_URL=http://localhost:3001
EMAIL_PROVIDER=devlog
# EMAIL_PROVIDER=resend em produção (devlog é recusado com NODE_ENV=production):
RESEND_API_KEY=
EMAIL_FROM="BoraFest <ingressos@borafest.com.br>"
# "Signing secret" do webhook do Resend (entregue/devolvido/spam), 2026-10-12.
# Vazio = a rota POST /v1/webhooks/resend recusa tudo.
RESEND_WEBHOOK_SECRET=
# devlog só em dev. Em produção: off (WhatsApp desligado por decisão; devlog é
# recusado) ou meta (Meta WhatsApp Cloud API, com as chaves abaixo):
WHATSAPP_PROVIDER=devlog
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# URL pública da API — monta o link do qr.png enviado no WhatsApp
API_PUBLIC_URL=http://localhost:3333
# PUSH_PROVIDER=expo é o default (Expo Push API é grátis, não precisa de conta) — devlog só se quiser desligar.
# EXPO_ACCESS_TOKEN= (opcional, evita rate-limit em volume alto)
# Web Push do painel (aviso de venda). Vazio = push desligado, sem erro.
# Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@borafest.com.br
