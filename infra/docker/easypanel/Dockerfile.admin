# Gerado para deploy via EasyPanel — APP e NEXT_PUBLIC_API_URL embutidos.
# Fonte: Dockerfile.web.

FROM node:20-alpine AS builder
ARG APP=admin
ARG NEXT_PUBLIC_API_URL=https://api.borafest.com.br
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN corepack enable
WORKDIR /repo

# manifests de TODO o workspace (o lockfile congelado exige todos)
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY apps/api/package.json apps/api/
COPY apps/worker/package.json apps/worker/
COPY apps/checkout/package.json apps/checkout/
COPY apps/producer/package.json apps/producer/
COPY apps/admin/package.json apps/admin/
COPY apps/mobile-checkin/package.json apps/mobile-checkin/
COPY packages/auth/package.json packages/auth/
COPY packages/config/package.json packages/config/
COPY packages/contracts/package.json packages/contracts/
COPY packages/database/package.json packages/database/
COPY packages/notifications/package.json packages/notifications/
COPY packages/observability/package.json packages/observability/
COPY packages/payments/package.json packages/payments/
COPY packages/queues/package.json packages/queues/
COPY packages/tickets/package.json packages/tickets/
COPY packages/ui/package.json packages/ui/
RUN pnpm install --frozen-lockfile --filter "@borafest/${APP}..."

# pacotes internos (@borafest/ui etc.) — os frontends passaram a consumi-los
COPY packages packages
COPY apps/${APP} apps/${APP}
RUN pnpm --filter "@borafest/${APP}" run build

# ---------------------------------------------------------------------------
FROM node:20-alpine AS runner
ARG APP=admin
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
WORKDIR /app

# saída standalone: server.js próprio + só as deps necessárias
COPY --from=builder /repo/apps/${APP}/.next/standalone ./
COPY --from=builder /repo/apps/${APP}/.next/static ./apps/${APP}/.next/static
# public/: manifest, service worker e ícones do PWA — sem isso dão 404 em produção
COPY --from=builder /repo/apps/${APP}/public ./apps/${APP}/public

EXPOSE 3000
# o server.js fica no caminho do app dentro do standalone do monorepo
ENV APP_DIR=apps/${APP}
CMD ["sh", "-c", "node ${APP_DIR}/server.js"]
