# Reverse proxy com HTTPS automático (Let's Encrypt).
# Os domínios vêm das variáveis de ambiente do serviço caddy no compose.

{$API_DOMAIN} {
	# flush_interval -1: manda cada chunk assim que a api escreve, sem
	# bufferizar — sem isso o SSE do ranking ao vivo (sales-by-partner/stream)
	# ficaria preso no buffer do Caddy e só chegaria no navegador em blocos.
	reverse_proxy api:3333 {
		flush_interval -1
	}
}

{$CHECKOUT_DOMAIN} {
	reverse_proxy checkout:3000
}

{$PRODUCER_DOMAIN} {
	reverse_proxy producer:3000
}

{$ADMIN_DOMAIN} {
	reverse_proxy admin:3000
}

{$GRAFANA_DOMAIN} {
	reverse_proxy grafana:3000
}
