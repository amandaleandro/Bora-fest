  amountCents Int      @map("amount_cents")
  createdAt   DateTime @default(now()) @map("created_at")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@map("coupon_redemptions")
}

model OrderAttendee {
  id          String  @id @default(uuid()) @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  ticketLotId String  @map("ticket_lot_id") @db.Uuid
  name        String
  cpf         String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_attendees")
}

model Consent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  orderId    String?  @map("order_id") @db.Uuid
  document   String
  version    String
  acceptedAt DateTime @default(now()) @map("accepted_at")
  ip         String?
  userAgent  String?  @map("user_agent")

  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([userId])
  @@map("consents")
}

model PayoutRequest {
  id                   String              @id @default(uuid()) @db.Uuid
  organizationId       String              @map("organization_id") @db.Uuid
  amountCents          Int                 @map("amount_cents")
  status               PayoutRequestStatus @default(PENDING)
  anticipation         Boolean             @default(false)
  anticipationFeeCents Int                 @default(0) @map("anticipation_fee_cents")
  bankAccountId        String?             @map("bank_account_id") @db.Uuid
  payoutId             String?             @map("payout_id") @db.Uuid
  notes                String?
  requestedBy          String?             @map("requested_by") @db.Uuid
  createdAt            DateTime            @default(now()) @map("created_at")
  resolvedAt           DateTime?           @map("resolved_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("payout_requests")
}

enum PayoutRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// Cross-cutting infra: outbox, idempotency, audit
// ---------------------------------------------------------------------------

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id")
  eventType     String       @map("event_type")
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now()) @map("available_at")
  processedAt   DateTime?    @map("processed_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([status, availableAt])
  @@map("outbox_events")
}

model IdempotencyKey {
  key          String    @id
  scope        String
  requestHash  String    @map("request_hash")
  responseBody Json?     @map("response_body")
  statusCode   Int?      @map("status_code")
  lockedAt     DateTime? @map("locked_at")
  completedAt DateTime?  @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([scope])
  @@map("idempotency_keys")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
