  @@map("ledger_accounts")
}

enum SettlementMode {
  STANDARD
  INSTANT
}

enum LedgerEntryType {
  SALE_CREDIT
  PLATFORM_FEE
  REFUND_DEBIT
  PAYOUT_DEBIT
  COMMISSION_DEBIT
  COMMISSION_CREDIT
  PROTECTION_CREDIT
  ANTICIPATION_FEE
}

model LedgerEntry {
