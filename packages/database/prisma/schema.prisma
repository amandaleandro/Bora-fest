generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum IdentityProvider {
  EMAIL
  GOOGLE
  APPLE
  PHONE
}

/// Papel de equipe interna da BoraFest (backoffice), independente das roles
/// de organização (owner/admin/finance/operator). null = usuário comum.
enum PlatformRole {
  SUPPORT
  ADMIN
}

model User {
  id                String        @id @default(uuid()) @db.Uuid
  name              String?
  email             String?       @unique
  phone             String?       @unique
  cpf               String?       @unique
  platformRole      PlatformRole? @map("platform_role")
  /// e-mail comprovado (código ou link mágico) — 1º ingresso só abre depois
  /// disso; contas nascidas invisíveis no checkout começam null
  emailVerifiedAt   DateTime?     @map("email_verified_at")
  /// login por senha (painel do produtor); compradores seguem sem senha (OTP)
  passwordHash      String?       @map("password_hash")
  termsAcceptedAt   DateTime?     @map("terms_accepted_at")
  /// preferências de marketing (transacional é sempre enviado)
  notifyWhatsapp    Boolean       @default(true) @map("notify_whatsapp")
  notifyEmailOffers Boolean       @default(false) @map("notify_email_offers")
  /// invalida sessões antigas: a troca de senha incrementa isto e o guard
  /// recusa tokens com versão menor (revogação — auditoria 2026-08-29)
  sessionVersion    Int           @default(0) @map("session_version")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  identities              UserIdentity[]
  otpChallenges           OtpChallenge[]
  passwordResetTokens     PasswordResetToken[]
  organizationMemberships OrganizationMember[]
  reservations            Reservation[]
  orders                  Order[]
  salesPartnerMemberships SalesPartnerMember[]
  guestListEntriesAdded   GuestListEntry[]
  salesOrders             Order[]               @relation("SalesOrderSeller")
  organizationFollows     OrganizationFollow[]
  eventReviews            EventReview[]
  ledgerAccount           LedgerAccount?
  promoterLinks           PromoterLink[]        @relation("PromoterPerson")
  promoterSellers         PromoterSeller[]      @relation("SellerPerson")
  webPushSubscriptions    WebPushSubscription[]

  @@map("users")
}

/// Inscrição de Web Push (PWA do painel): 1 por navegador/dispositivo do usuário.
/// A notificação de venda cai aqui (gamificação 2026-08-12). Endpoint é único —
/// o mesmo aparelho re-inscrevendo apenas atualiza as chaves.
model WebPushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("web_push_subscriptions")
}

model UserIdentity {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  provider   IdentityProvider
  providerId String           @map("provider_id")
  createdAt  DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("user_identities")
}

/// Redefinição de senha do painel (validade curta, uso único).
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

enum OtpChannel {
  EMAIL
  SMS
  WHATSAPP
}

model OtpChallenge {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String?    @map("user_id") @db.Uuid
  destination String
  channel     OtpChannel
  codeHash    String     @map("code_hash")
  attempts    Int        @default(0)
  consumedAt  DateTime?  @map("consumed_at")
  expiresAt   DateTime   @map("expires_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([destination])
  @@map("otp_challenges")
}

// ---------------------------------------------------------------------------
// Organizations & RBAC
// ---------------------------------------------------------------------------

enum OrganizationKind {
  INDIVIDUAL
  COMPANY
}

/// Classificação comercial do produtor (decisão 2026-08-10): segmenta
/// relatórios, contratos de confiança (casas) e funcionalidades (atléticas
/// → promoters). Obrigatória no cadastro novo; null = conta legada.
enum ProducerType {
  CASA
  ATLETICA
  PRODUTORA
  INDEPENDENTE
  OUTRO
}

enum OrganizationStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BLOCKED
}

model Organization {
  id                           String             @id @default(uuid()) @db.Uuid
  name                         String
  slug                         String             @unique
  kind                         OrganizationKind
  producerType                 ProducerType?      @map("producer_type")
  document                     String             @unique
  /// nome comercial mostrado ao público (marca/atlética); null = usa `name`.
  /// Criado porque produtor pessoa física aparecia com o nome civil no site.
  displayName                  String?            @map("display_name")
  /// identidade permanente da Casa na vitrine pública.
  bio                          String?
  logoUrl                      String?            @map("logo_url")
  coverUrl                     String?            @map("cover_url")
  /// tema padrão herdado pelos eventos que não definirem ticketTheme próprio.
  defaultTicketTheme           Json?              @map("default_ticket_theme")
  instagramUrl                 String?            @map("instagram_url")
  websiteUrl                   String?            @map("website_url")
  status                       OrganizationStatus @default(PENDING_VERIFICATION)
  /// Overrides de taxa (basis points; 499 = 4,99%). null = usa o padrão da plataforma.
  pixFeeBps                    Int?               @map("pix_fee_bps")
  pixFeeFloorCents             Int?               @map("pix_fee_floor_cents")
  cardFeeBps                   Int?               @map("card_fee_bps")
  /// STANDARD: crédito de venda só libera para saque após a janela de
  /// reembolso. INSTANT: libera na hora (casas de confiança) — a
  /// responsabilidade contratual pelo reembolso passa à casa e a parcela
  /// dentro da janela paga antecipação (decisão 2026-07-28).
  settlementMode               SettlementMode     @default(STANDARD) @map("settlement_mode")
  /// dias da janela de reembolso (CDC art. 49 = 7); conta a partir do pagamento
  refundHoldDays               Int                @default(7) @map("refund_hold_days")
  /// repasse automático: worker cria os payouts do saldo recém-liberado
  autoPayout                   Boolean            @default(false) @map("auto_payout")
  /// mínimo por repasse DESTA casa (centavos); null = padrão da plataforma
  /// (AUTO_PAYOUT_MIN_CENTS) — evita chuva de transferência pequena
  autoPayoutMinCents           Int?               @map("auto_payout_min_cents")
  /// teto de UM saque imediato desta casa (contrato de confiança); acima
  /// disso o pedido cai para aprovação do backoffice. null = sem teto.
  instantMaxPerWithdrawalCents Int?               @map("instant_max_per_withdrawal_cents")
  createdAt                    DateTime           @default(now()) @map("created_at")
  updatedAt                    DateTime           @updatedAt @map("updated_at")

  members        OrganizationMember[]
  verifications  OrganizerVerification[]
  bankAccounts   BankAccount[]
  payoutRequests PayoutRequest[]
  venues         Venue[]
  events         Event[]
  ledgerAccount  LedgerAccount?
  payouts        Payout[]
  salesPartners  SalesPartner[]
  promoterHosts  PromoterLink[]          @relation("PromoterHost")
  followers      OrganizationFollow[]
  products       StoreProduct[]

  @@map("organizations")
}

/// Comprador "segue" um produtor/atlética — notificado por e-mail quando um novo evento é publicado.
model OrganizationFollow {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_follows")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  permissions RolePermission[]
  members     OrganizationMember[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

enum OrganizationMemberStatus {
  INVITED
  ACTIVE
  REMOVED
}

model OrganizationMember {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  userId         String                   @map("user_id") @db.Uuid
  roleId         String                   @map("role_id") @db.Uuid
  salesPartnerId String?                  @map("sales_partner_id") @db.Uuid
  status         OrganizationMemberStatus @default(INVITED)
  invitedAt      DateTime                 @default(now()) @map("invited_at")
  joinedAt       DateTime?                @map("joined_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role          @relation(fields: [roleId], references: [id])
  salesPartner SalesPartner? @relation(fields: [salesPartnerId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model PromoterLink {
  id                   String                 @id @default(uuid()) @db.Uuid
  organizationId       String                 @map("organization_id") @db.Uuid
  promoterUserId       String                 @map("promoter_user_id") @db.Uuid
  status               PromoterLinkStatus     @default(INVITED)
  commissionType       PromoterCommissionType @default(NONE) @map("commission_type")
  commissionBps        Int                    @default(0) @map("commission_bps")
  commissionFixedCents Int                    @default(0) @map("commission_fixed_cents")
  guestQuota           Int                    @default(0) @map("guest_quota")
  slug                 String                 @unique
  code                 String?                @unique
  eventId              String?                @map("event_id") @db.Uuid
  invitedBy            String?                @map("invited_by") @db.Uuid
  invitedAt            DateTime               @default(now()) @map("invited_at")
  respondedAt          DateTime?              @map("responded_at")

  organization Organization     @relation("PromoterHost", fields: [organizationId], references: [id], onDelete: Cascade)
  promoterUser User             @relation("PromoterPerson", fields: [promoterUserId], references: [id], onDelete: Cascade)
  event        Event?           @relation("PromoterEventScope", fields: [eventId], references: [id], onDelete: Cascade)
  sellers      PromoterSeller[]
  orders       Order[]
  reservations Reservation[]

  @@unique([organizationId, promoterUserId])
  @@index([promoterUserId, status])
  @@map("promoter_links")
}

enum PromoterCommissionType {
  NONE
  PERCENT
  FIXED
}

model PromoterSeller {
  id             String             @id @default(uuid()) @db.Uuid
  promoterLinkId String             @map("promoter_link_id") @db.Uuid
  sellerUserId   String             @map("seller_user_id") @db.Uuid
  status         PromoterLinkStatus @default(INVITED)
  slug           String             @unique
  invitedAt      DateTime           @default(now()) @map("invited_at")
  respondedAt    DateTime?          @map("responded_at")

  promoterLink PromoterLink @relation(fields: [promoterLinkId], references: [id], onDelete: Cascade)
  sellerUser   User         @relation("SellerPerson", fields: [sellerUserId], references: [id], onDelete: Cascade)
  orders       Order[]
  reservations Reservation[]

  @@unique([promoterLinkId, sellerUserId])
  @@index([sellerUserId, status])
  @@map("promoter_sellers")
}

enum PromoterLinkStatus {
  INVITED
  ACTIVE
  DECLINED
  REMOVED
}

model SalesPartner {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  slug           String
  commissionBps  Int      @default(0) @map("commission_bps")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members             SalesPartnerMember[]
  organizationMembers OrganizationMember[]
  orders              Order[]
  events              EventSalesPartner[]
  guestListEntries    GuestListEntry[]

  @@unique([organizationId, name])
  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("sales_partners")
}

model SalesPartnerMember {
  id        String @id @default(uuid()) @db.Uuid
  partnerId String @map("partner_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid

  partner SalesPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([partnerId, userId])
  @@index([userId])
  @@map("sales_partner_members")
}

model EventSalesPartner {
  eventId   String @map("event_id") @db.Uuid
  partnerId String @map("partner_id") @db.Uuid

  event   Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  partner SalesPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@id([eventId, partnerId])
  @@index([partnerId])
  @@map("event_sales_partners")
}

enum GuestListEntryStatus {
  CONFIRMED
  CHECKED_IN
  CANCELED
}

model GuestListEntry {
  id             String               @id @default(uuid()) @db.Uuid
  eventId        String               @map("event_id") @db.Uuid
  ticketLotId    String               @map("ticket_lot_id") @db.Uuid
  salesPartnerId String?              @map("sales_partner_id") @db.Uuid
  addedByUserId  String               @map("added_by_user_id") @db.Uuid
  orderId        String?              @map("order_id") @db.Uuid
  guestName      String               @map("guest_name")
  guestDocument  String?              @map("guest_document")
  guestPhone     String?              @map("guest_phone")
  status         GuestListEntryStatus @default(CONFIRMED)
  ticketId       String?              @unique @map("ticket_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketLot    TicketLot     @relation(fields: [ticketLotId], references: [id])
  salesPartner SalesPartner? @relation(fields: [salesPartnerId], references: [id], onDelete: SetNull)
  addedByUser  User          @relation(fields: [addedByUserId], references: [id])
  order        Order?        @relation(fields: [orderId], references: [id])
  ticket       Ticket?       @relation(fields: [ticketId], references: [id])

  @@index([eventId, status])
  @@index([salesPartnerId])
  @@index([orderId])
  @@map("guest_list_entries")
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model OrganizerVerification {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  status         VerificationStatus @default(PENDING)
  provider       String
  providerRef    String?            @map("provider_ref")
  reviewedBy     String?            @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?          @map("reviewed_at")
  notes          String?
  createdAt      DateTime           @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("organizer_verifications")
}

model BankAccount {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  holderName      String    @map("holder_name")
  holderDocument  String    @map("holder_document")
  bankCode        String    @map("bank_code")
  agency          String
  account         String
  accountType     String    @map("account_type")
  pixKey          String?   @map("pix_key")
  pixKeyUpdatedAt DateTime? @map("pix_key_updated_at")
  isDefault       Boolean   @default(false) @map("is_default")
  createdAt       DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("bank_accounts")
}

// ---------------------------------------------------------------------------
// Events & Catalog
// ---------------------------------------------------------------------------

model Venue {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  address        String?
  mapsUrl        String?  @map("maps_url")
  city           String
  state          String
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events       Event[]

  @@index([organizationId])
  @@map("venues")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  SALES_PAUSED
  SALES_CLOSED
  COMPLETED
  CANCELED
}

model Event {
  id                     String         @id @default(uuid()) @db.Uuid
  organizationId         String         @map("organization_id") @db.Uuid
  venueId                String?        @map("venue_id") @db.Uuid
  title                  String
  slug                   String         @unique
  description            String?
  lineup                 String?
  amenities              String?
  minAge                 Int?           @map("min_age")
  bannerUrl              String?        @map("banner_url")
  category               EventCategory? @map("category")
  status                 EventStatus    @default(DRAFT)
  startsAt               DateTime       @map("starts_at")
  endsAt                 DateTime       @map("ends_at")
  timezone               String         @default("America/Sao_Paulo")
  publishedAt            DateTime?      @map("published_at")
  canceledAt             DateTime?      @map("canceled_at")
  waitingRoomEnabled     Boolean        @default(false) @map("waiting_room_enabled")
  waitingRoomConcurrency Int            @default(300) @map("waiting_room_concurrency")
  pixelSettings          Json?          @map("pixel_settings")
  metaCapiToken          String?        @map("meta_capi_token")
  /// tema visual do ingresso; não altera QR, validade ou regras de acesso.
  ticketTheme            Json?          @map("ticket_theme")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  venue                Venue?                @relation(fields: [venueId], references: [id])
  ticketTypes          TicketType[]
  reservations         Reservation[]
  orders               Order[]
  tickets              Ticket[]
  signingKey           EventSigningKey?
  coupons              Coupon[]
  checkinPoints        CheckinPoint[]
  validatorCredentials ValidatorCredential[]
  validatorDevices     ValidatorDevice[]
  salesPartners        EventSalesPartner[]
  reviews              EventReview[]
  addOns               EventAddOn[]
  vipInventories       VipInventory[]
  guestListEntries     GuestListEntry[]
  promoterLinks        PromoterLink[]        @relation("PromoterEventScope")

  @@index([organizationId])
  @@index([status])
  @@index([category])
  @@map("events")
}

enum EventCategory {
  SHOWS
  FESTAS
  ESPORTES
  TEATRO
}


enum StoreProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model StoreProduct {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  name           String
  slug           String
  description    String?
  imageUrl       String?            @map("image_url")
  status         StoreProductStatus @default(DRAFT)
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  variants     StoreProductVariant[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@map("store_products")
}

model StoreProductVariant {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  name          String
  sku           String?
  priceCents    Int      @map("price_cents")
  stockTotal   Int      @default(0) @map("stock_total")
  reservedCount Int      @default(0) @map("reserved_count")
  soldCount     Int      @default(0) @map("sold_count")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product StoreProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@unique([productId, sku])
  @@index([productId, active])
  @@map("store_product_variants")
}

model EventAddOn {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  name        String
  description String?
  priceCents  Int      @map("price_cents")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  event      Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderItems OrderAddOnItem[]

  @@index([eventId])
  @@map("event_add_ons")
}

model OrderAddOnItem {
  id         String @id @default(uuid()) @db.Uuid
  orderId    String @map("order_id") @db.Uuid
  addOnId    String @map("add_on_id") @db.Uuid
  quantity   Int
  priceCents Int    @map("price_cents")

  order Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  addOn EventAddOn @relation(fields: [addOnId], references: [id])

  @@index([orderId])
  @@map("order_add_on_items")
}

enum VipInventoryKind {
  MESA
  CAMAROTE
  LOUNGE
  BISTRO
  OUTRO
}

enum VipReservationStatus {
  REQUESTED
  CONFIRMED
  REJECTED
  CANCELED
}

/// Unidade reservável separada de ingresso: mesa, camarote, lounge ou bistrô.
/// `quantity` é o número de unidades físicas disponíveis; capacidade é por unidade.
model VipInventory {
  id                     String           @id @default(uuid()) @db.Uuid
  eventId                String           @map("event_id") @db.Uuid
  kind                   VipInventoryKind
  name                   String
  description            String?
  benefits               String?
  unitPriceCents         Int              @map("unit_price_cents")
  quantity               Int
  capacityPerUnit        Int              @map("capacity_per_unit")
  maxUnitsPerReservation Int              @default(1) @map("max_units_per_reservation")
  active                 Boolean          @default(true)
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  event        Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reservations VipReservation[]

  @@index([eventId, active])
  @@map("vip_inventory")
}

/// Pedido de reserva VIP. Não é um ingresso e não vira pagamento neste N8.
/// Preço é congelado no momento do pedido para alterações futuras do inventário
/// não reescreverem a proposta que o cliente recebeu.
model VipReservation {
  id                String               @id @default(uuid()) @db.Uuid
  publicToken       String               @unique @default(uuid()) @map("public_token")
  vipInventoryId    String               @map("vip_inventory_id") @db.Uuid
  contactName       String               @map("contact_name")
  contactEmail      String               @map("contact_email")
  contactPhone      String               @map("contact_phone")
  partySize         Int                  @map("party_size")
  units             Int                  @default(1)
  unitPriceCents    Int                  @map("unit_price_cents")
  totalCents        Int                  @map("total_cents")
  status            VipReservationStatus @default(REQUESTED)
  customerNote      String?              @map("customer_note")
  resolutionNote    String?              @map("resolution_note")
  respondedAt       DateTime?            @map("responded_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  inventory VipInventory @relation(fields: [vipInventoryId], references: [id], onDelete: Cascade)

  @@index([vipInventoryId, status])
  @@index([contactEmail])
  @@index([createdAt])
  @@map("vip_reservations")
}

model EventReview {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@map("event_reviews")
}

model TicketType {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  name        String
  description String?
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  event Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  lots  TicketLot[]

  @@index([eventId])
  @@map("ticket_types")
}

enum FeeMode {
  BUYER
  PRODUCER
}

enum LotStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  SOLD_OUT
  CLOSED
}

model TicketLot {
  id               String    @id @default(uuid()) @db.Uuid
  ticketTypeId     String    @map("ticket_type_id") @db.Uuid
  name             String
  priceCents       Int       @map("price_cents")
  feeCents         Int       @default(0) @map("fee_cents")
  capacity         Int
  soldCount        Int       @default(0) @map("sold_count")
  reservedCount    Int       @default(0) @map("reserved_count")
  maxPerOrder      Int       @default(6) @map("max_per_order")
  feeMode          FeeMode   @default(BUYER) @map("fee_mode")
  nominal          Boolean   @default(false)
  requiresCpf      Boolean   @default(false) @map("requires_cpf")
  halfPriceEnabled Boolean   @default(false) @map("half_price_enabled")
  pdvOnly          Boolean   @default(false) @map("pdv_only")
  promoterOnly     Boolean   @default(false) @map("promoter_only")
  status           LotStatus @default(DRAFT)
  startsAt         DateTime? @map("starts_at")
  endsAt           DateTime? @map("ends_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  ticketType       TicketType        @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  reservationItems ReservationItem[]
  orderItems       OrderItem[]
  tickets          Ticket[]
  guestListEntries GuestListEntry[]

  @@index([ticketTypeId])
  @@index([status])
  @@map("ticket_lots")
}

// ---------------------------------------------------------------------------
// Reservas e pedidos (venda)
// ---------------------------------------------------------------------------

enum ReservationStatus {
  ACTIVE
  CONVERTED
  EXPIRED
  CANCELED
}

model Reservation {
  id               String            @id @default(uuid()) @db.Uuid
  eventId          String            @map("event_id") @db.Uuid
  userId           String?           @map("user_id") @db.Uuid
  promoterLinkId   String?           @map("promoter_link_id") @db.Uuid
  promoterSellerId String?           @map("promoter_seller_id") @db.Uuid
  status           ReservationStatus @default(ACTIVE)
  expiresAt DateTime          @map("expires_at")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  promoterLink   PromoterLink?   @relation(fields: [promoterLinkId], references: [id], onDelete: SetNull)
  promoterSeller PromoterSeller? @relation(fields: [promoterSellerId], references: [id], onDelete: SetNull)
  items          ReservationItem[]
  order          Order?

  @@index([status, expiresAt])
  @@index([eventId])
  @@index([promoterLinkId])
  @@index([promoterSellerId])
  @@map("reservations")
}

model ReservationItem {
  id            String  @id @default(uuid()) @db.Uuid
  reservationId String  @map("reservation_id") @db.Uuid
  ticketLotId   String  @map("ticket_lot_id") @db.Uuid
  quantity      Int
  priceCents    Int     @map("price_cents")
  feeCents      Int     @map("fee_cents")
  halfPrice     Boolean @default(false) @map("half_price")

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  ticketLot   TicketLot   @relation(fields: [ticketLotId], references: [id])

  @@index([reservationId])
  @@map("reservation_items")
}

enum OrderStatus {
  CREATED
  PAYMENT_PENDING
  PAID
  FULFILLED
  EXPIRED
  CANCELED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
  CHARGEBACK
}

enum OrderAttributionSource {
  MANUAL
  LINK
}

model Order {
  id                      String                  @id @default(uuid()) @db.Uuid
  publicToken             String                  @unique @default(uuid()) @map("public_token")
  eventId                 String                  @map("event_id") @db.Uuid
  reservationId           String                  @unique @map("reservation_id") @db.Uuid
  userId                  String?                 @map("user_id") @db.Uuid
  salesPartnerId          String?                 @map("sales_partner_id") @db.Uuid
  promoterLinkId          String?                 @map("promoter_link_id") @db.Uuid
  promoterSellerId        String?                 @map("promoter_seller_id") @db.Uuid
  promoterCommissionCents Int                     @default(0) @map("promoter_commission_cents")
  accountCreatedByOrder   Boolean                 @default(false) @map("account_created_by_order")
  soldByUserId            String?                 @map("sold_by_user_id") @db.Uuid
  partnerCommissionCents  Int                     @default(0) @map("partner_commission_cents")
  attributionSource       OrderAttributionSource? @map("attribution_source")
  contactEmail            String                  @map("contact_email")
  contactName             String?                 @map("contact_name")
  contactPhone            String?                 @map("contact_phone")
  status                  OrderStatus             @default(CREATED)
  totalCents              Int                     @map("total_cents")
  protectionPurchased     Boolean                 @default(false) @map("protection_purchased")
  protectionFeeCents      Int                     @default(0) @map("protection_fee_cents")
  discountCents           Int                     @default(0) @map("discount_cents")
  expiresAt               DateTime?               @map("expires_at")
  paidAt                  DateTime?               @map("paid_at")
  abandonedReminderSentAt DateTime?               @map("abandoned_reminder_sent_at")
  rescueReminderSentAt    DateTime?               @map("rescue_reminder_sent_at")
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")

  event            Event             @relation(fields: [eventId], references: [id])
  reservation      Reservation       @relation(fields: [reservationId], references: [id])
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  salesPartner     SalesPartner?     @relation(fields: [salesPartnerId], references: [id], onDelete: SetNull)
  promoterLink     PromoterLink?     @relation(fields: [promoterLinkId], references: [id], onDelete: SetNull)
  promoterSeller   PromoterSeller?   @relation(fields: [promoterSellerId], references: [id], onDelete: SetNull)
  soldByUser       User?             @relation("SalesOrderSeller", fields: [soldByUserId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  payments         Payment[]
  couponRedemption CouponRedemption?
  attendees        OrderAttendee[]
  consents         Consent[]
  tickets          Ticket[]
  refundRequests   RefundRequest[]
  pushTokens       PushToken[]
  addOnItems       OrderAddOnItem[]
  guestListEntries GuestListEntry[]

  @@index([eventId])
  @@index([status])
  @@index([status, expiresAt])
  @@index([salesPartnerId])
  @@index([contactEmail])
  @@index([userId, createdAt])
  @@index([promoterLinkId])
  @@index([promoterSellerId])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid()) @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  ticketLotId String  @map("ticket_lot_id") @db.Uuid
  quantity    Int
  priceCents  Int     @map("price_cents")
  feeCents    Int     @map("fee_cents")
  halfPrice   Boolean @default(false) @map("half_price")

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketLot TicketLot @relation(fields: [ticketLotId], references: [id])
  tickets   Ticket[]

  @@index([orderId])
  @@map("order_items")
}

// ---------------------------------------------------------------------------
// Pagamentos (Fase 4)
// ---------------------------------------------------------------------------

enum PaymentMethod {
  PIX
  CARD
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELED
  EXPIRED
  REFUND_PENDING
  REFUNDED
  CHARGEBACK
}

enum RefundRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model RefundRequest {
  id               String              @id @default(uuid()) @db.Uuid
  orderId          String              @map("order_id") @db.Uuid
  reason           String
  status           RefundRequestStatus @default(PENDING)
  requestedAt      DateTime            @default(now()) @map("requested_at")
  resolvedAt       DateTime?           @map("resolved_at")
  resolvedByUserId String?             @map("resolved_by_user_id") @db.Uuid
  resolutionNote   String?             @map("resolution_note")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
  @@map("refund_requests")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  orderId        String        @map("order_id") @db.Uuid
  provider       String
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  amountCents    Int           @map("amount_cents")
  externalId     String?       @map("external_id")
  idempotencyKey String?       @unique @map("idempotency_key")
  pixQrCodeText  String?       @map("pix_qr_code_text")
  installments   Int?
  failReason     String?       @map("fail_reason")
  expiresAt      DateTime?     @map("expires_at")
  paidAt         DateTime?     @map("paid_at")
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  order  Order          @relation(fields: [orderId], references: [id])
  events PaymentEvent[]

  @@unique([provider, externalId])
  @@index([orderId])
  @@index([status, expiresAt])
  @@map("payments")
}

model PaymentEvent {
  id              String    @id @default(uuid()) @db.Uuid
  paymentId       String    @map("payment_id") @db.Uuid
  provider        String
  externalEventId String    @map("external_event_id")
  type            String
  payload         Json
  processedAt     DateTime? @map("processed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([provider, externalEventId])
  @@index([paymentId])
  @@map("payment_events")
}

enum WebhookDeliveryStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

model WebhookDelivery {
  id              String                @id @default(uuid()) @db.Uuid
  provider        String
  eventType       String?               @map("event_type")
  externalEventId String?               @map("external_event_id")
  signatureValid  Boolean               @map("signature_valid")
  status          WebhookDeliveryStatus @default(RECEIVED)
  error           String?
  rawBody         String                @map("raw_body")
  headers         Json
  receivedAt      DateTime              @default(now()) @map("received_at")
  processedAt     DateTime?             @map("processed_at")

  @@index([provider, receivedAt])
  @@map("webhook_deliveries")
}

// ---------------------------------------------------------------------------
// Ingressos (Fase 4 — emissão)
// ---------------------------------------------------------------------------

enum TicketStatus {
  ISSUED
  ACTIVE
  CHECKED_IN
  TRANSFERRED
  CANCELED
  REFUNDED
}

model Ticket {
  id            String       @id @default(uuid()) @db.Uuid
  orderId       String       @map("order_id") @db.Uuid
  ownerUserId   String?      @map("owner_user_id") @db.Uuid
  orderItemId   String       @map("order_item_id") @db.Uuid
  eventId       String       @map("event_id") @db.Uuid
  ticketLotId   String       @map("ticket_lot_id") @db.Uuid
  seq           Int
  code          String       @unique
  qrToken       String       @map("qr_token")
  status        TicketStatus @default(ISSUED)
  attendeeName  String?      @map("attendee_name")
  attendeeEmail String?      @map("attendee_email")
  attendeeCpf   String?      @map("attendee_cpf")
  issuedAt      DateTime     @default(now()) @map("issued_at")
  checkedInAt   DateTime?    @map("checked_in_at")
  canceledAt    DateTime?    @map("canceled_at")
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at")

  order          Order           @relation(fields: [orderId], references: [id])
  orderItem      OrderItem       @relation(fields: [orderItemId], references: [id])
  event          Event           @relation(fields: [eventId], references: [id])
  ticketLot      TicketLot       @relation(fields: [ticketLotId], references: [id])
  checkins       Checkin[]
  guestListEntry GuestListEntry?

  @@unique([orderItemId, seq])
  @@index([eventId, status])
  @@index([eventId, updatedAt])
  @@index([orderId])
  @@index([eventId, issuedAt])
  @@map("tickets")
}

// ---------------------------------------------------------------------------
// Check-in (Fases 6/7 — lado servidor)
// ---------------------------------------------------------------------------

model CheckinPoint {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  checkins Checkin[]

  @@unique([eventId, name])
  @@map("checkin_points")
}

model ValidatorCredential {
  id        String    @id @default(uuid()) @db.Uuid
  eventId   String    @map("event_id") @db.Uuid
  label     String
  pinHash   String    @map("pin_hash")
  active    Boolean   @default(true)
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  event   Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  devices ValidatorDevice[]

  @@unique([eventId, label])
  @@map("validator_credentials")
}

enum ValidatorDeviceStatus {
  ACTIVE
  BLOCKED
}

model ValidatorDevice {
  id           String                @id @default(uuid()) @db.Uuid
  credentialId String                @map("credential_id") @db.Uuid
  eventId      String                @map("event_id") @db.Uuid
  name         String
  tokenHash    String                @map("token_hash")
  status       ValidatorDeviceStatus @default(ACTIVE)
  registeredAt DateTime              @default(now()) @map("registered_at")
  lastSeenAt   DateTime?             @map("last_seen_at")
  lastSyncAt   DateTime?             @map("last_sync_at")

  credential  ValidatorCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  event       Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  checkins    Checkin[]
  syncBatches CheckinSyncBatch[]

  @@index([eventId, status])
  @@map("validator_devices")
}

enum CheckinSource {
  ONLINE
  OFFLINE_SYNC
}

enum CheckinStatus {
  CONFIRMED
  CONFLICT
  REVERSED
}

model Checkin {
  id             String        @id @default(uuid()) @db.Uuid
  ticketId       String        @map("ticket_id") @db.Uuid
  eventId        String        @map("event_id") @db.Uuid
  deviceId       String        @map("device_id") @db.Uuid
  checkinPointId String?       @map("checkin_point_id") @db.Uuid
  source         CheckinSource
  status         CheckinStatus
  localSeq       Int?          @map("local_seq")
  scannedAt      DateTime      @map("scanned_at")
  receivedAt     DateTime      @default(now()) @map("received_at")
  reversedAt     DateTime?     @map("reversed_at")
  reversedBy     String?       @map("reversed_by") @db.Uuid

  ticket       Ticket          @relation(fields: [ticketId], references: [id])
  device       ValidatorDevice @relation(fields: [deviceId], references: [id])
  checkinPoint CheckinPoint?   @relation(fields: [checkinPointId], references: [id])

  @@unique([deviceId, localSeq])
  @@index([eventId, receivedAt])
  @@index([ticketId])
  @@map("checkins")
}

model CheckinSyncBatch {
  id            String   @id @default(uuid()) @db.Uuid
  deviceId      String   @map("device_id") @db.Uuid
  batchKey      String   @map("batch_key")
  itemCount     Int      @map("item_count")
  conflictCount Int      @map("conflict_count")
  result        Json
  receivedAt    DateTime @default(now()) @map("received_at")

  device ValidatorDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, batchKey])
  @@map("checkin_sync_batches")
}

// ---------------------------------------------------------------------------
// Notificações (Fase 5 — entrega de ingressos e avisos)
// ---------------------------------------------------------------------------

enum NotificationChannel {
  EMAIL
  WHATSAPP
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Notification {
  id          String              @id @default(uuid()) @db.Uuid
  channel     NotificationChannel
  recipient   String
  template    String
  payload     Json
  status      NotificationStatus  @default(PENDING)
  attempts    Int                 @default(0)
  error       String?
  availableAt DateTime            @default(now()) @map("available_at")
  sentAt      DateTime?           @map("sent_at")
  orderId     String?             @map("order_id") @db.Uuid
  createdAt   DateTime            @default(now()) @map("created_at")

  @@index([status, availableAt])
  @@index([orderId])
  @@map("notifications")
}

model PushToken {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  token     String   @unique
  platform  String
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("push_tokens")
}

model EventSigningKey {
  id            String   @id @default(uuid()) @db.Uuid
  eventId       String   @unique @map("event_id") @db.Uuid
  algorithm     String   @default("ed25519")
  publicKeyPem  String   @map("public_key_pem")
  privateKeyPem String   @map("private_key_pem")
  createdAt     DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_signing_keys")
}

// ---------------------------------------------------------------------------
// Ledger e repasses (Fase 9)
// ---------------------------------------------------------------------------

model LedgerAccount {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @unique @map("organization_id") @db.Uuid
  userId         String?  @unique @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
